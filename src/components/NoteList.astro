---
// Every note: each series in reading order, then the standalone notes apart from them.
import NoteItem from './NoteItem.astro';
import { seriesUrl, type Library } from '../lib/notes';
interface Props {
  library: Library;
  /** Notes and series pages show descriptions and link series names. Home's search list does neither. */
  rich?: boolean;
  id?: string;
  hidden?: boolean;
}
const { library, rich = false, id, hidden = false } = Astro.props;
const groups = [
  ...library.series.map(s => ({ name: s.name, href: seriesUrl(s), notes: s.notes, ordered: true })),
  ...(library.standalone.length ? [{ name: 'Standalone notes', href: undefined, notes: library.standalone, ordered: false }] : []),
];
---
<div class:list={['list', { rich }]} id={id} hidden={hidden}>
  {groups.map((g, i) => {
    const Tag = g.ordered ? 'ol' : 'ul';
    return (
      <section class="group" data-g={i}>
        <h2 class="gname">{rich && g.href ? <a href={g.href}>{g.name}</a> : g.name}</h2>
        <Tag class="items">{g.notes.map(note => <NoteItem note={note} rich={rich} />)}</Tag>
      </section>
    );
  })}
</div>
