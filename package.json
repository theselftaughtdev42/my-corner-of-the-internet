{
  "name": "my-corner-of-the-internet",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:prose": "vale src/content/notes src/pages/pathway.md templates",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky && vale sync",
    "check:links": "linkinator '**/*.html' --server-root dist",
    "check:html": "html-validate \"dist/**/*.html\""
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/rss": "^4.0.19",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.3.7",
    "fast-xml-parser": "^5.11.2",
    "fast-xml-validator": "^1.4.2",
    "pagefind": "^1.5.2",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "satori": "^0.36.0",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vvago/vale": "^3.24.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.13.0",
    "html-validate": "^11.4.0",
    "husky": "^9.1.7",
    "linkinator": "^8.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript-eslint": "^8.71.1",
    "unified": "^11.0.5",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{js,mjs,ts,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,yaml,yml}": "prettier --write",
    "{src/content/notes/**/*.md,src/pages/pathway.md,templates/*.md}": "vale --minAlertLevel=warning"
  },
  "overrides": {
    "html-validate": {
      "vitest": "$vitest"
    }
  }
}
